# --- Core ---
# PostgreSQL connection string. Local dev example:
DATABASE_URL="postgresql://tcc:tcc@localhost:5432/tcc?schema=public"

# 32+ char secret used to sign session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# 32-byte hex key used to encrypt stored provider credentials (AES-256-GCM).
# Generate: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=""

# Base URL of the app (used in password reset links)
APP_URL="http://localhost:3000"

# --- AI provider (optional; falls back to deterministic mock provider) ---
# Supported: anthropic | mock
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Embeddings (optional; falls back to local deterministic embeddings) ---
# Supported: openai | local
EMBEDDING_PROVIDER="local"
OPENAI_API_KEY=""

# --- Transcription (optional; simulated mode always available) ---
# Supported: simulated | deepgram
TRANSCRIPTION_PROVIDER="simulated"
DEEPGRAM_API_KEY=""

# --- Storage ---
# Supported: local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Email (password reset). If unset, reset links are logged to server console. ---
RESEND_API_KEY=""
EMAIL_FROM="Technical Call Copilot <noreply@example.com>"

# Daily AI token ceiling per organization (input + output). 0 disables the cap.
AI_DAILY_TOKEN_CAP=750000
